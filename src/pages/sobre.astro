---
import BaseLayout from '../layouts/BaseLayout.astro';
import StratumDivider from '../components/StratumDivider.astro';

const skills = [
  { icon: '🛰', name: 'Detecção Remota', desc: 'Análise de imagens de satélite para mapeamento e monitorização de ecossistemas costeiros ao longo do tempo.', chips: ['Google Earth Engine', 'Sentinel-2', 'Landsat', 'NDVI'], delay: 0 },
  { icon: '🐍', name: 'Programação científica', desc: 'Python como ferramenta de análise de dados ambientais, visualização e automação de processos científicos.', chips: ['Python', 'Dados geoespaciais', 'Visualização'], delay: 0.1 },
  { icon: '🌿', name: 'Ciência de campo', desc: 'Observação e registo de biodiversidade costeira. Identificação de espécies, monitorização intertidal e ciência comunitária.', chips: ['iNaturalist', 'Ecologia costeira', 'Manguezal'], delay: 0.2 },
  { icon: '🌍', name: 'Línguas', desc: 'Comunicação científica em três idiomas, essencial para colaborações internacionais e divulgação.', chips: ['Português', 'English', 'Español'], delay: 0.05 },
  { icon: '👥', name: 'Liderança técnica', desc: '6 anos de gestão de equipas em contexto técnico. Tradução entre linguagens científicas e humanas.', chips: ['Gestão de equipas', 'Comunicação'], delay: 0.15 },
  { icon: '💻', name: 'Desenvolvimento web', desc: 'Pós-graduação Full Stack. Competência técnica aplicada à divulgação e visualização científica.', chips: ['HTML · CSS · JS', 'Full Stack'], delay: 0.25 },
];

const lugaresGroups = [
  {
    country: 'Islândia',
    photos: [
      { n: 1, caption: 'Reynisfjara' },
      { n: 4, caption: 'Sólheimajökull' },
      { n: 2, caption: 'Terras Altas da Islândia' },
      { n: 7, caption: 'Mýrdalsjökull' },
      { n: 5, caption: 'Mýrdalsjökull' },
      { n: 8, caption: 'Mýrdalssandur' },
      { n: 6, caption: 'Gruta de gelo, Mýrdalsjökull' },
      { n: 11, caption: 'Reynisfjara' },
      { n: 9, caption: 'Reykjavik' },
      { n: 19, caption: 'Kirkjufell' },
      { n: 10, caption: 'Reynisfjara' },
    ],
  },
  {
    country: 'Irlanda',
    photos: [
      { n: 3, caption: 'Cliffs of Moher' },
      { n: 20, caption: 'Dingle Peninsula' },
      { n: 18, caption: 'Connemara' },
    ],
  },
  {
    country: 'Nova Zelândia',
    photos: [
      { n: 23, caption: 'Mount Eden, Auckland' },
      { n: 14, caption: 'Cathedral Cove, Coromandel' },
      { n: 22, caption: 'Mount Eden, Auckland' },
      { n: 15, caption: 'Glen Innes' },
      { n: 12, caption: 'Whakarewarewa Forest, Rotorua' },
      { n: 13, caption: 'Rotorua' },
      { n: 24, caption: 'Takapuna' },
      { n: 25, caption: 'Waiheke Island' },
      { n: 16, caption: 'Coromandel Peninsula' },
      { n: 26, caption: 'Waiheke Island' },
      { n: 27, caption: 'Waiheke Island' },
      { n: 21, caption: 'Onetangi Beach, Waiheke Island' },
      { n: 17, caption: 'Hot Water Beach' },
    ],
  },
].map((g) => ({
  country: g.country,
  photos: g.photos.map((p) => ({ src: `/lugares/lugares-${String(p.n).padStart(2, '0')}.jpeg`, caption: p.caption })),
}));

const timeline = [
  { year: 'Salvador, BA', title: 'Ilha de Bom Jesus dos Passos', desc: 'Cresceu numa família de marisqueiros e pescadores. O oceano e a geologia costeira como primeiros laboratórios.', delay: 0 },
  { year: 'Chapada Diamantina', title: 'O tempo geológico visível', desc: 'Antes da universidade, o planalto de quartzito e as cavernas confirmaram o que já sabia: queria trabalhar com geologia e ambiente.', delay: 0.08 },
  { year: 'UFBA', title: 'Licenciatura em Ciências e Tecnologia', desc: 'Disciplinas em Ecologia, Climatologia, Oceanografia, Ciências da Terra e Geologia. Base científica multidisciplinar que une ambiente, dados e sistemas complexos.', delay: 0.16 },
  { year: 'UNOPAR', title: 'Pós-graduação em Desenvolvimento Web Full Stack', desc: 'Formação técnica em desenvolvimento de software. Competência que a ciência ambiental moderna cada vez mais precisa: dados, visualização, automação.', delay: 0.24 },
  { year: '6 anos', title: 'Liderança de equipas em ambiente técnico', desc: 'Gestão de operações e equipas. Tradução entre linguagens técnicas e humanas, competência rara e valiosa na ciência.', delay: 0.32 },
  { year: 'Em curso, 2025/2026', title: 'Candidatura a mestrado', desc: 'Geologia, ciências da Terra e ambiente. Objectivo de seguir para doutoramento em sistemas costeiros e detecção remota.', delay: 0.40 },
];
---

<BaseLayout title="Sobre — Adriane Bulhões" description="Investigadora em Ciências da Terra. Geologia, oceano e detecção remota, entre a Bahia, a Irlanda e a Nova Zelândia.">
  <!-- HERO -->
  <section class="sobre-hero">
    <div class="glow" style="width:600px;height:600px;background:rgba(74,154,176,.1);top:-150px;right:-200px;animation-delay:-6s;"></div>
    <div class="glow" style="width:350px;height:350px;background:rgba(192,90,32,.06);bottom:0;left:10%;animation-delay:-13s;"></div>
    <div class="page-hero-eyebrow">Sobre mim</div>
    <h1 class="page-hero-title">Adriane<br />Bulhões</h1>
    <p class="page-hero-sub">Investigadora em Ciências da Terra. Bahia, Irlanda, Nova Zelândia.</p>
  </section>

  <StratumDivider fill="#111618" />

  <!-- INTRO + FOTO -->
  <section class="sobre-intro">
    <div class="sobre-intro-grid">
      <div class="photo-col reveal">
        <div class="photo-frame">
          <div class="photo-placeholder">
            <svg viewBox="0 0 340 453" xmlns="http://www.w3.org/2000/svg">
              <rect width="340" height="453" fill="#162020" />
              <path d="M0,100 Q85,88 170,104 Q255,120 340,96 L340,0 L0,0 Z" fill="#0c1a22" opacity=".9" />
              <path d="M0,50 Q85,38 170,52 Q255,65 340,42" fill="none" stroke="#4a9ab0" stroke-width=".6" opacity=".4" />
              <path d="M0,100 Q85,88 170,105 Q255,122 340,98" fill="#1e2e2e" stroke="#2a3f3f" stroke-width="1" />
              <path d="M0,165 Q70,150 170,168 Q270,185 340,160" fill="#162020" stroke="#2a5a6a" stroke-width=".8" opacity=".6" />
              <path d="M0,240 Q90,224 170,242 Q250,258 340,233" fill="#1e2e2e" stroke="#3a7a8a" stroke-width=".8" opacity=".5" />
              <path d="M0,330 Q80,312 170,332 Q260,350 340,324" fill="#162020" stroke="#b8922a" stroke-width=".7" opacity=".3" />
              <path d="M0,420 Q100,400 170,422 Q240,442 340,412" fill="#111618" stroke="#4a9ab0" stroke-width=".6" opacity=".3" />
              <path d="M155,453 Q165,350 168,240 Q170,165 172,100 Q174,50 170,0" fill="none" stroke="#c05a20" stroke-width="1.5" opacity=".3" stroke-dasharray="8 5" />
              <g transform="translate(170,310)" opacity=".4">
                <polygon points="0,-45 20,-12 14,32 -14,32 -20,-12" fill="none" stroke="#89c4d4" stroke-width=".8" />
                <polygon points="0,-28 12,-6 8,20 -8,20 -12,-6" fill="none" stroke="#89c4d4" stroke-width=".5" opacity=".5" />
              </g>
              <g fill="none" stroke="#1e2e2e" stroke-width=".5">
                <line x1="22" y1="100" x2="32" y2="100" />
                <line x1="22" y1="165" x2="32" y2="165" />
                <line x1="22" y1="240" x2="32" y2="240" />
                <line x1="22" y1="330" x2="32" y2="330" />
              </g>
              <text x="36" y="104" fill="#2a5a6a" font-family="DM Mono,monospace" font-size="7" opacity=".6">0m</text>
              <text x="36" y="169" fill="#2a5a6a" font-family="DM Mono,monospace" font-size="7" opacity=".5">−65m</text>
              <text x="36" y="244" fill="#2a5a6a" font-family="DM Mono,monospace" font-size="7" opacity=".4">−140m</text>
              <text x="36" y="334" fill="#2a5a6a" font-family="DM Mono,monospace" font-size="7" opacity=".3">−230m</text>
            </svg>
          </div>
        </div>
        <p class="photo-caption">Foto na natureza, em breve</p>
        <div class="location-trail">
          <div class="loc-item"><div class="loc-dot"></div><span>Salvador, Bahia · origem</span></div>
          <div class="loc-item"><div class="loc-dot"></div><span>Ilha de Bom Jesus dos Passos</span></div>
          <div class="loc-item"><div class="loc-dot"></div><span>Irlanda · segundo olhar</span></div>
          <div class="loc-item now"><div class="loc-dot"></div><span>Waiheke Island, NZ · agora</span></div>
        </div>
      </div>

      <div class="reveal" style="transition-delay:.12s">
        <h2 class="sobre-title">Cresci entre<br />raízes e <em>maré</em>.</h2>
        <div class="sobre-text">
          <p>Desde criança gostei de geologia. Os vulcões, as rochas, a ideia de que aquilo que pisamos tem camadas e idade. Cresci em Salvador e passava as férias na Ilha de Bom Jesus dos Passos, onde a minha família é de marisqueiros e pescadores. Foi ali que ganhei o amor pelo oceano, que nunca mais me deixou.</p>
          <p>O interesse pela geologia veio por conta própria, cedo. Ia aos museus de história natural ver as rochas expostas, e ainda hoje, quando chego a um país novo, procuro logo a sua geologia e os seus museus. Gostava de estar perto daquilo, mesmo sem saber ainda o que fazer com esse interesse.</p>
          <p>Foi na Chapada Diamantina, antes da universidade, que percebi que queria trabalhar com isto. O planalto de quartzito, as cavernas, o tempo geológico visível na rocha. Saí de lá com a questão já decidida.</p>
          <p>Na universidade o interesse ganhou método. Tenho formação em <strong>Ciências e Tecnologia pela UFBA</strong>, com disciplinas em Ecologia, Oceanografia, Ciências da Terra e Geologia. Lembro de passar nos corredores e parar diante das amostras de rocha expostas, com a mesma curiosidade que tinha nos museus em criança. Tenho também pós-graduação em <strong>Desenvolvimento Web Full Stack</strong>, que uso para trabalhar com dados, visualização e automação.</p>
          <p>Depois da universidade vivi na Irlanda, e agora em Waiheke Island, na Nova Zelândia, onde a geologia vulcânica costeira me dá uma nova forma de ver as mesmas perguntas. Três países, três relações diferentes entre uma comunidade e o seu ambiente. Isso mudou bastante a forma como penso a ciência.</p>
          <p>O oceano e a rocha foram as paixões da minha infância, e continuam a ser o centro do que estudo.</p>
        </div>
      </div>
    </div>
  </section>

  <StratumDivider fill="#162020" bg="#111618" />

  <!-- SKILLS -->
  <section class="skills-section">
    <div class="section-label">Ferramentas &amp; competências <span>ciência</span></div>
    <div class="skills-grid">
      {skills.map((s) => (
        <div class="skill-block reveal" style={s.delay ? `transition-delay:${s.delay}s` : undefined}>
          <div class="skill-icon">{s.icon}</div>
          <div class="skill-name">{s.name}</div>
          <div class="skill-desc">{s.desc}</div>
          <div class="skill-chips">{s.chips.map((c) => <span class="chip">{c}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <StratumDivider fill="#111618" bg="#162020" />

  <!-- GALERIA -->
  <section class="gallery-section">
    <div class="section-label">Na natureza <span>lugares que me formaram</span></div>
    {lugaresGroups.map((g) => (
      <div class="gallery-group">
        <div class="gallery-country">{g.country}</div>
        <div class="gallery-grid">
          {g.photos.map((l, i) => (
            <div class="gallery-item reveal" style={i % 4 ? `transition-delay:${(i % 4) * 0.1}s` : undefined}>
              <img src={l.src} alt={l.caption} loading="lazy" />
              <div class="gallery-label">{l.caption}</div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <StratumDivider fill="#162020" bg="#111618" />

  <!-- PERCURSO -->
  <section class="timeline-section">
    <div class="glow" style="width:500px;height:500px;background:rgba(74,154,176,.07);top:20%;right:-200px;animation-delay:-9s;"></div>
    <div class="section-label">Percurso <span>formação</span></div>
    <div class="timeline">
      {timeline.map((t) => (
        <div class="t-item reveal" style={t.delay ? `transition-delay:${t.delay}s` : undefined}>
          <div class="t-year">{t.year}</div>
          <div class="t-title">{t.title}</div>
          <div class="t-desc">{t.desc}</div>
        </div>
      ))}
    </div>
  </section>

  <StratumDivider fill="#0a0e0f" bg="#162020" />

  <!-- CTA -->
  <section class="sobre-cta">
    <div class="reveal sobre-cta-row">
      <h2>Ver a investigação <em>em curso</em>.</h2>
      <div class="sobre-cta-actions">
        <a href="/projetos" class="clink clink-primary">Projetos</a>
        <a href="/contato" class="clink">Contacto</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sobre-hero {
    min-height: 65vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 3rem 5rem;
    position: relative;
    z-index: 10;
    overflow: hidden;
  }
  .sobre-intro { background: var(--obsidian); padding: 7rem 3rem; position: relative; z-index: 10; }
  .sobre-intro-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 6rem; align-items: start; }
  .photo-col { position: sticky; top: 8rem; }
  .photo-frame { width: 100%; max-width: 340px; aspect-ratio: 3 / 4; position: relative; margin-bottom: 2rem; }
  .photo-placeholder {
    width: 100%;
    height: 100%;
    background: var(--deep-rock);
    border: 1px solid rgba(200, 232, 240, 0.07);
    overflow: hidden;
    position: relative;
  }
  .photo-placeholder svg { width: 100%; height: 100%; position: absolute; inset: 0; }
  .photo-caption { font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-dim); }

  .location-trail { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 1.5rem; }
  .loc-item { display: flex; align-items: center; gap: 0.9rem; font-size: 0.68rem; letter-spacing: 0.08em; color: var(--text-dim); }
  .loc-item.now { color: var(--glacier-mid); }
  .loc-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--text-ghost); flex-shrink: 0; }
  .loc-item.now .loc-dot { background: var(--glacier-mid); box-shadow: 0 0 10px rgba(138, 196, 212, 0.5); }

  .sobre-title {
    font-family: var(--ff-serif);
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    margin-bottom: 2.5rem;
  }
  .sobre-title em { font-style: italic; color: var(--glacier-mid); }
  .sobre-text p { font-size: 0.9rem; line-height: 2; color: #6a9aaa; margin-bottom: 1.6rem; font-weight: 300; }
  .sobre-text p strong { color: var(--glacier-pale); font-weight: 400; }
  .sobre-text .pull {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--text-mid);
    line-height: 1.4;
    border-left: 1px solid var(--glacier-deep);
    padding-left: 1.5rem;
    margin: 2.5rem 0;
  }

  /* SKILLS */
  .skills-section { background: var(--deep-rock); padding: 7rem 3rem; position: relative; z-index: 10; }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(200, 232, 240, 0.06);
    border: 1px solid rgba(200, 232, 240, 0.06);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 3rem;
  }
  .skill-block { background: var(--obsidian); padding: 2rem; transition: background 0.3s; }
  .skill-block:hover { background: var(--rock-mid); }
  .skill-icon { font-size: 1.4rem; margin-bottom: 0.8rem; }
  .skill-name { font-family: var(--ff-serif); font-size: 1.1rem; font-weight: 400; color: var(--glacier-pale); margin-bottom: 0.5rem; }
  .skill-desc { font-size: 0.75rem; line-height: 1.7; color: var(--text-dim); font-weight: 300; }
  .skill-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 1rem; }
  .chip { font-size: 0.52rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.28em 0.7em; border: 1px solid rgba(74, 154, 176, 0.25); color: var(--glacier-deep); }

  /* GALLERY */
  .gallery-section { background: var(--obsidian); padding: 7rem 3rem; position: relative; z-index: 10; }
  .gallery-group { margin-top: 3.5rem; }
  .gallery-group:first-of-type { margin-top: 3rem; }
  .gallery-country {
    font-family: var(--ff-serif);
    font-size: 1.1rem;
    font-weight: 300;
    font-style: italic;
    color: var(--glacier-mid);
    margin-bottom: 1rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(200, 232, 240, 0.05);
    border: 1px solid rgba(200, 232, 240, 0.05);
    border-radius: 3px;
    overflow: hidden;
  }
  .gallery-item { aspect-ratio: 1 / 1; background: var(--deep-rock); position: relative; overflow: hidden; }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }
  .gallery-item:hover img { transform: scale(1.04); }
  .gallery-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.6rem 1rem 0.7rem;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(232, 244, 248, 0.92);
    background: linear-gradient(to top, rgba(8, 12, 13, 0.85), transparent);
    z-index: 2;
    pointer-events: none;
  }

  /* TIMELINE */
  .timeline-section { background: var(--deep-rock); padding: 7rem 3rem; position: relative; z-index: 10; overflow: hidden; }
  .timeline { position: relative; max-width: 700px; margin-top: 1rem; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--glacier-deep), transparent);
  }
  .t-item { padding-left: 2.8rem; padding-bottom: 3.8rem; position: relative; }
  .t-item::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--deep-rock);
    border: 1px solid var(--glacier-deep);
    box-shadow: 0 0 12px rgba(74, 154, 176, 0.35);
  }
  .t-year { font-size: 0.58rem; letter-spacing: 0.2em; color: var(--glacier-deep); margin-bottom: 0.45rem; text-transform: uppercase; }
  .t-title { font-family: var(--ff-serif); font-size: 1.15rem; font-weight: 400; color: var(--glacier-pale); margin-bottom: 0.45rem; line-height: 1.2; }
  .t-desc { font-size: 0.78rem; line-height: 1.75; color: var(--text-dim); font-weight: 300; }

  /* CTA */
  .sobre-cta { background: var(--basalt); padding: 5rem 3rem; position: relative; z-index: 10; }
  .sobre-cta-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem; }
  .sobre-cta-row h2 { font-family: var(--ff-serif); font-size: clamp(1.8rem, 3.5vw, 3rem); font-weight: 300; }
  .sobre-cta-row h2 em { font-style: italic; color: var(--mineral-pale); }
  .sobre-cta-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .sobre-intro-grid { grid-template-columns: 1fr; gap: 3rem; }
    .photo-col { position: static; }
    .photo-frame { max-width: 260px; }
    .skills-grid { grid-template-columns: 1fr; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

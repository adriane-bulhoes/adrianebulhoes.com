---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StratumDivider from '../../../components/StratumDivider.astro';
import ProjetoTeaserCard from '../../../components/ProjetoTeaserCard.astro';

const projects = (
  await getCollection('projetos', ({ data }) => data.lang === 'en' && (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects — Adriane Bulhões" lang="en" description="Three territories. Brazil, Portugal and New Zealand, between geology, coastal ecology and remote sensing.">
  <!-- HERO -->
  <section class="proj-hero">
    <div class="glow" style="width:650px;height:650px;background:rgba(184,146,42,.07);top:-150px;right:-200px;animation-delay:-5s;"></div>
    <div class="glow" style="width:400px;height:400px;background:rgba(74,154,176,.07);bottom:0;left:5%;animation-delay:-12s;"></div>
    <div class="page-hero-eyebrow">Research</div>
    <h1 class="page-hero-title">Research<br /><em>in progress</em></h1>
    <p class="page-hero-sub">Three territories. Brazil, Portugal and New Zealand, between geology, coastal ecology and remote sensing.</p>
  </section>

  <StratumDivider fill="#111618" />

  <!-- LISTING -->
  <section class="proj-list">
    <div class="section-label">Projects <span>research</span></div>
    <p class="proj-narrative reveal">Three islands, three continents, three ecological trajectories. In Brazil, the loss of mangrove on a fishing island. In Portugal, the forest consumed by fire in an increasingly hot and dry climate. In New Zealand, the recovery of native vegetation through restoration programmes. Together they show that remote sensing, with Google Earth Engine and Python, makes both loss and recovery visible and measurable.</p>
    {projects.length === 0 ? (
      <p class="proj-empty-note">No projects published yet.</p>
    ) : (
      <div class="proj-grid">
        {projects.map((projeto, i) => <ProjetoTeaserCard projeto={projeto} index={i} lang="en" basePath="/en/projects" />)}
      </div>
    )}
  </section>

  <StratumDivider fill="#0a0e0f" bg="#111618" />

  <!-- CTA -->
  <section class="proj-cta">
    <div class="reveal proj-cta-row">
      <h2>See the <em>field notes</em>.</h2>
      <div class="proj-cta-actions">
        <a href="/en/field-notes" class="clink clink-primary">Field Notes</a>
        <a href="/en/contact" class="clink">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .proj-hero {
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 3rem 5rem;
    position: relative;
    z-index: 10;
    overflow: hidden;
  }
  .proj-list { background: var(--obsidian); padding: 7rem 3rem; position: relative; z-index: 10; }
  .proj-narrative { font-size: 0.9rem; line-height: 1.95; color: #6a9aaa; max-width: 700px; margin-bottom: 4rem; font-weight: 300; }
  .proj-empty-note { font-size: 0.85rem; color: var(--text-dim); }
  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: rgba(200, 232, 240, 0.05); border: 1px solid rgba(200, 232, 240, 0.05); border-radius: 3px; overflow: hidden; }
  .proj-cta { background: var(--basalt); padding: 5rem 3rem; position: relative; z-index: 10; }
  .proj-cta-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem; }
  .proj-cta-row h2 { font-family: var(--ff-serif); font-size: clamp(1.8rem, 3.5vw, 3rem); font-weight: 300; }
  .proj-cta-row h2 em { font-style: italic; color: var(--mineral-pale); }
  .proj-cta-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  @media (max-width: 900px) {
    .proj-grid { grid-template-columns: 1fr; }
    .proj-hero { padding: 0 1.5rem 4rem; }
  }
</style>

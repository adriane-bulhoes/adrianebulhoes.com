---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Adriane Bulhões" lang="en" description="Master's applications, scientific collaborations and questions about geology and Earth sciences. Let's talk.">
  <div class="contact-page">
    <div class="contact-bg-text" aria-hidden="true">talk</div>
    <div class="glow" style="width:700px;height:700px;background:rgba(74,154,176,.08);top:-200px;right:-250px;animation-delay:-6s;"></div>
    <div class="glow" style="width:400px;height:400px;background:rgba(192,90,32,.05);bottom:-100px;left:-100px;animation-delay:-15s;"></div>

    <div class="contact-grid">
      <!-- LEFT -->
      <div class="contact-left reveal">
        <div class="contact-eyebrow">Contact</div>
        <h1 class="contact-title">Let's<br /><em>talk</em>.</h1>
        <p class="contact-sub">Master's applications, scientific collaborations, questions about the projects or about Earth and environmental sciences. Any topic related to the work is welcome.</p>

        <div class="contact-cards">
          <a href="mailto:adrianebulhoes1@gmail.com" class="contact-card primary">
            <div class="cc-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 7L2 7" /></svg>
            </div>
            <div>
              <div class="cc-label">Email</div>
              <div class="cc-value">adrianebulhoes1@gmail.com</div>
            </div>
          </a>
          <a href="https://www.linkedin.com/in/adriane-bulhoes/" target="_blank" rel="noopener" class="contact-card">
            <div class="cc-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg>
            </div>
            <div>
              <div class="cc-label">LinkedIn</div>
              <div class="cc-value">linkedin.com/in/adriane-bulhoes</div>
            </div>
          </a>
          <a href="https://www.inaturalist.org/people/adrianebulhoes" target="_blank" rel="noopener" class="contact-card">
            <div class="cc-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" /></svg>
            </div>
            <div>
              <div class="cc-label">iNaturalist</div>
              <div class="cc-value">inaturalist.org/people/adrianebulhoes</div>
            </div>
          </a>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="contact-right reveal" style="transition-delay:.15s">
        <div class="contact-status">
          <div class="status-indicator">
            <div class="status-dot"></div>
            <span class="status-text">Available for contact</span>
          </div>
          <p class="status-detail">
            Based on <strong>Waiheke Island, New Zealand</strong> (UTC+12).<br />
            Preparing application for a <strong>Master's in geology and Earth sciences</strong>.<br />
            Open to collaborations, research partnerships and conversations about science.
          </p>
        </div>

        <div class="interest-list">
          <p class="interest-title">Collaboration interests</p>
          <div class="interest-item"><p><strong>Mangrove ecology:</strong> research, monitoring or conservation projects in tropical coastal zones.</p></div>
          <div class="interest-item"><p><strong>Remote sensing:</strong> temporal analysis of vegetation cover, land use change, satellite mapping.</p></div>
          <div class="interest-item"><p><strong>Community science:</strong> projects that involve coastal communities in the production or validation of environmental data.</p></div>
          <div class="interest-item"><p><strong>Master's / PhD applications:</strong> supervisors or programmes in geology, Earth sciences and coastal ecosystems.</p></div>
        </div>

        <div class="location-now">
          <p>
            <strong>Current location</strong>
            Waiheke Island, Auckland, New Zealand<br />
            36°47'S · 175°06'E<br /><br />
            Origin: Salvador, Bahia, Brazil<br />
            12°57'S · 38°37'W
          </p>
        </div>
      </div>
    </div>

    <div class="geo-sig">
      <p class="coords">Earth · water · science</p>
      <p>Adriane Bulhões · 2025</p>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 10;
    padding: 10rem 3rem 7rem;
    overflow: hidden;
  }
  .contact-bg-text {
    position: absolute;
    font-family: var(--ff-serif);
    font-size: 22vw;
    font-weight: 300;
    color: rgba(200, 232, 240, 0.025);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    pointer-events: none;
    font-style: italic;
  }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7rem; align-items: start; position: relative; }
  .contact-eyebrow {
    font-size: 0.55rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--lava-glow);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .contact-eyebrow::after { content: ''; flex: 1; max-width: 60px; height: 1px; background: linear-gradient(to right, var(--lava-glow), transparent); }
  .contact-title { font-family: var(--ff-serif); font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 300; line-height: 0.95; margin-bottom: 1.5rem; }
  .contact-title em { font-style: italic; color: var(--glacier-mid); }
  .contact-sub { font-size: 0.85rem; color: var(--text-dim); max-width: 400px; line-height: 1.85; font-weight: 300; margin-bottom: 3rem; }

  .contact-cards { display: flex; flex-direction: column; gap: 0.8rem; }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.4rem 1.6rem;
    border: 1px solid rgba(200, 232, 240, 0.08);
    border-radius: 3px;
    text-decoration: none;
    color: var(--text-bright);
    transition: all 0.35s;
    background: var(--obsidian);
    position: relative;
    overflow: hidden;
  }
  .contact-card::before { content: ''; position: absolute; inset: 0; left: -100%; background: linear-gradient(to right, transparent, rgba(74, 154, 176, 0.08), transparent); transition: left 0.5s ease; }
  .contact-card:hover::before { left: 100%; }
  .contact-card:hover { border-color: rgba(200, 232, 240, 0.2); background: var(--deep-rock); }
  .contact-card.primary { background: var(--glacier-deep); border-color: var(--glacier-deep); color: var(--basalt); }
  .contact-card.primary:hover { background: var(--glacier-mid); border-color: var(--glacier-mid); color: var(--basalt); }
  .cc-icon { width: 36px; height: 36px; border: 1px solid rgba(200, 232, 240, 0.15); border-radius: 2px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .contact-card.primary .cc-icon { border-color: rgba(12, 15, 15, 0.3); }
  .cc-label { font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: inherit; opacity: 0.6; margin-bottom: 0.2rem; }
  .cc-value { font-size: 0.82rem; color: inherit; }

  .contact-right { padding-top: 2rem; }
  .contact-status { margin-bottom: 3rem; }
  .status-indicator { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1rem; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--glacier-mid); box-shadow: 0 0 12px rgba(138, 196, 212, 0.5); animation: statusPulse 2.5s ease-in-out infinite; }
  @keyframes statusPulse { 0%, 100% { opacity: 1; box-shadow: 0 0 12px rgba(138, 196, 212, 0.5); } 50% { opacity: 0.5; box-shadow: 0 0 6px rgba(138, 196, 212, 0.2); } }
  .status-text { font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--glacier-mid); }
  .status-detail { font-size: 0.8rem; line-height: 1.8; color: var(--text-dim); font-weight: 300; }
  .status-detail strong { color: var(--glacier-pale); font-weight: 400; }

  .interest-list { margin-bottom: 3rem; }
  .interest-title { font-size: 0.55rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--lava-glow); margin-bottom: 1.2rem; }
  .interest-item { display: flex; align-items: flex-start; gap: 0.8rem; margin-bottom: 0.8rem; }
  .interest-item::before { content: '→'; color: var(--glacier-deep); font-size: 0.7rem; margin-top: 0.1rem; flex-shrink: 0; }
  .interest-item p { font-size: 0.8rem; line-height: 1.6; color: var(--text-dim); font-weight: 300; }
  .interest-item p strong { color: var(--text-mid); font-weight: 400; }

  .location-now { padding: 1.5rem; background: var(--deep-rock); border-left: 2px solid var(--glacier-deep); border-radius: 0 2px 2px 0; }
  .location-now p { font-size: 0.7rem; letter-spacing: 0.08em; color: var(--text-dim); line-height: 1.9; }
  .location-now strong { color: var(--glacier-pale); font-weight: 400; display: block; font-size: 0.82rem; margin-bottom: 0.4rem; }

  .geo-sig { position: absolute; bottom: 3rem; right: 3rem; text-align: right; }
  .geo-sig p { font-size: 0.55rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-ghost); line-height: 2; }
  .geo-sig .coords { font-family: var(--ff-serif); font-style: italic; font-size: 0.9rem; color: var(--text-ghost); }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 3.5rem; }
    .contact-page { padding: 8rem 1.5rem 5rem; }
    .geo-sig { position: static; text-align: left; margin-top: 3rem; }
  }
</style>

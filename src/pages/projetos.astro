---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StratumDivider from '../components/StratumDivider.astro';
import ProjetoTeaserCard from '../components/ProjetoTeaserCard.astro';

const projetos = (
  await getCollection('projetos', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projetos — Adriane Santana Bulhões" description="Dois territórios, uma mesma pergunta sobre pressão e resistência dos ecossistemas costeiros.">
  <!-- HERO -->
  <section class="proj-hero">
    <div class="glow" style="width:650px;height:650px;background:rgba(184,146,42,.07);top:-150px;right:-200px;animation-delay:-5s;"></div>
    <div class="glow" style="width:400px;height:400px;background:rgba(74,154,176,.07);bottom:0;left:5%;animation-delay:-12s;"></div>
    <div class="page-hero-eyebrow">Investigação</div>
    <h1 class="page-hero-title">Projetos<br /><em>em curso</em></h1>
    <p class="page-hero-sub">Dois territórios. Uma mesma pergunta sobre pressão, perda e resistência dos ecossistemas costeiros.</p>
  </section>

  <StratumDivider fill="#111618" />

  <!-- LISTING -->
  <section class="proj-list">
    <div class="section-label">Projetos <span>— investigação</span></div>
    {projetos.length === 0 ? (
      <p class="proj-empty-note">Ainda não há projetos publicados — em breve.</p>
    ) : (
      <div class="proj-grid">
        {projetos.map((projeto, i) => <ProjetoTeaserCard projeto={projeto} index={i} />)}
      </div>
    )}
  </section>

  <StratumDivider fill="#0a0e0f" bg="#111618" />

  <!-- CTA -->
  <section class="proj-cta">
    <div class="reveal proj-cta-row">
      <h2>Ver as <em>notas de campo</em>.</h2>
      <div class="proj-cta-actions">
        <a href="/fieldnotes" class="clink clink-primary">Field Notes</a>
        <a href="/contato" class="clink">Colaborar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .proj-hero {
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 3rem 5rem;
    position: relative;
    z-index: 10;
    overflow: hidden;
  }

  .proj-list { background: var(--obsidian); padding: 6rem 3rem 7rem; position: relative; z-index: 10; }
  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 1rem; }
  .proj-empty-note { color: var(--text-dim); font-style: italic; font-family: var(--ff-serif); font-size: 1.2rem; }

  .proj-cta { background: var(--basalt); padding: 5rem 3rem; position: relative; z-index: 10; }
  .proj-cta-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem; }
  .proj-cta-row h2 { font-family: var(--ff-serif); font-size: clamp(1.8rem, 3.5vw, 3rem); font-weight: 300; }
  .proj-cta-row h2 em { font-style: italic; color: var(--glacier-mid); }
  .proj-cta-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .proj-list { padding: 4rem 1.5rem 5rem; }
    .proj-grid { grid-template-columns: 1fr; }
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { monthYear } from '../lib/format-date';

interface Props {
  note: CollectionEntry<'fieldnotes'>;
  featured?: boolean;
  index?: number;
}
const { note, featured = false, index = 0 } = Astro.props;
const { title, date, location, tags, excerpt, cover } = note.data;
const href = `/fieldnotes/${note.id}`;
const delay = index ? `transition-delay:${Math.min(index, 4) * 0.08}s` : undefined;
---

<article class:list={['note-card', 'reveal', { featured }]} style={delay}>
  {cover && (
    <a href={href} class="note-vis">
      <Image src={cover} alt={title} width={760} height={420} />
    </a>
  )}
  <div class="note-body">
    <div class="note-meta">
      <span class="note-date">{monthYear(date)}</span>
      <span class="note-loc">{location}</span>
    </div>
    <h2 class="note-title"><a href={href}>{title}</a></h2>
    {excerpt && <p class="note-excerpt">{excerpt}</p>}
    <div class="note-footer">
      <div class="note-tags">{tags.map((t) => <span class="note-tag">{t}</span>)}</div>
      <a href={href} class="note-read">Ler nota</a>
    </div>
  </div>
</article>

<style>
  .note-card {
    background: var(--obsidian);
    transition: background 0.3s;
    display: flex;
    flex-direction: column;
  }
  .note-card:hover { background: var(--deep-rock); }
  .note-card.featured { grid-column: span 2; flex-direction: row; }

  .note-vis { flex-shrink: 0; overflow: hidden; display: block; }
  .note-card:not(.featured) .note-vis { height: 180px; }
  .note-card.featured .note-vis { width: 380px; }
  .note-vis :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  .note-body { padding: 2.5rem; flex: 1; display: flex; flex-direction: column; }
  .note-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
  .note-date { font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--glacier-deep); }
  .note-loc { font-size: 0.58rem; letter-spacing: 0.1em; color: var(--text-dim); display: flex; align-items: center; gap: 0.4rem; }
  .note-loc::before { content: '◎'; font-size: 0.5rem; color: var(--lava-glow); }
  .note-title { font-family: var(--ff-serif); font-size: 1.5rem; font-weight: 300; line-height: 1.2; color: var(--glacier-pale); margin-bottom: 1rem; }
  .note-title a { text-decoration: none; color: inherit; transition: color 0.3s; }
  .note-title a:hover { color: var(--glacier-mid); }
  .note-card.featured .note-title { font-size: 2rem; }
  .note-excerpt { font-size: 0.85rem; line-height: 1.9; color: #6a9aaa; font-weight: 300; flex: 1; }
  .note-excerpt em { font-family: var(--ff-serif); font-style: italic; color: var(--text-mid); }
  .note-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; flex-wrap: wrap; gap: 0.5rem; }
  .note-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .note-tag { font-size: 0.52rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--lava-glow); }
  .note-read { font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--glacier-deep); text-decoration: none; transition: color 0.3s; }
  .note-read:hover { color: var(--glacier-pale); }
  .note-read::after { content: ' →'; }

  @media (max-width: 900px) {
    .note-card.featured { flex-direction: column; grid-column: span 1; }
    .note-card.featured .note-vis { width: 100%; height: 200px; }
  }
</style>

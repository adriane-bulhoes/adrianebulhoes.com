---
interface Props {
  lang?: 'pt' | 'en';
}
const { lang = 'pt' } = Astro.props;
---

<footer>
  <p>Adriane Bulhões · Salvador, Bahia · Waiheke, NZ</p>
  <span class="footer-element">{lang === 'en' ? 'Earth, water, science.' : 'Terra, água, ciência.'}</span>
  <p>{lang === 'en' ? 'Geology · Ocean · Earth Sciences' : 'Geologia · Oceano · Ciências da Terra'}</p>
</footer>

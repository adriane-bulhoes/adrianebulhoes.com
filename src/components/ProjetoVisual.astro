---
import { Image } from 'astro:assets';

/**
 * Project visual: renders the uploaded `cover` image when present, otherwise one
 * of four preset SVG scenes selected by `visual` (hybrid visuals — Constitution
 * VII). Presets keep new projects on-brand without needing design work.
 */
interface Props {
  visual?: 'mangrove' | 'geothermal' | 'satellite-grid' | 'basalt-strata';
  cover?: ImageMetadata;
  alt: string;
}
const { visual = 'satellite-grid', cover, alt } = Astro.props;
---

{
  cover ? (
    <Image src={cover} alt={alt} width={760} height={420} class="pvis-img" />
  ) : (
    <div class="pvis" role="img" aria-label={`Ilustração — ${alt}`}>
      {visual === 'mangrove' && (
        <svg viewBox="0 0 580 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="pvMangroveOcean" cx="45%" cy="60%" r="70%">
              <stop offset="0%" stop-color="#0d2535" /><stop offset="100%" stop-color="#040c14" />
            </radialGradient>
          </defs>
          <rect width="580" height="320" fill="url(#pvMangroveOcean)" />
          <g fill="none" opacity=".2" stroke="#4a9ab0">
            <ellipse cx="270" cy="255" rx="240" ry="74" stroke-width=".8" />
            <ellipse cx="270" cy="242" rx="190" ry="58" stroke-width=".7" />
            <ellipse cx="270" cy="230" rx="140" ry="44" stroke-width=".6" />
          </g>
          <path d="M120,300 Q150,250 170,200 Q190,152 225,132 Q260,112 288,122 Q316,132 332,160 Q348,188 366,214 Q384,240 408,268 Z" fill="#1a3828" opacity=".95" />
          <path d="M138,300 Q166,254 184,206 Q202,160 232,140 Q262,120 288,130 Q314,140 330,166 Q346,192 362,216 Z" fill="#1e4535" opacity=".7" />
          <ellipse cx="215" cy="178" rx="34" ry="17" fill="#0d3a22" opacity=".9" />
          <ellipse cx="262" cy="160" rx="26" ry="13" fill="#0d3a22" opacity=".85" />
          <rect x="250" y="148" width="20" height="14" rx="1" fill="#8a4010" opacity=".7" />
          <g opacity=".08" stroke="#89c4d4" stroke-width=".5">
            <line x1="145" y1="0" x2="145" y2="320" /><line x1="290" y1="0" x2="290" y2="320" /><line x1="435" y1="0" x2="435" y2="320" />
            <line x1="0" y1="80" x2="580" y2="80" /><line x1="0" y1="160" x2="580" y2="160" /><line x1="0" y1="240" x2="580" y2="240" />
          </g>
          <circle cx="262" cy="178" r="4" fill="#c05a20" opacity=".9">
            <animate attributeName="r" values="4;24;4" dur="3s" repeatCount="indefinite" />
            <animate attributeName="opacity" values=".9;0;.9" dur="3s" repeatCount="indefinite" />
          </circle>
          <circle cx="262" cy="178" r="3.5" fill="#c05a20" opacity=".9" />
          <text x="14" y="308" fill="rgba(137,196,212,.2)" font-family="DM Mono,monospace" font-size="8" letter-spacing="1">manguezal · análise temporal</text>
        </svg>
      )}
      {visual === 'geothermal' && (
        <svg viewBox="0 0 580 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <rect width="580" height="320" fill="#1a1008" />
          <circle cx="290" cy="160" r="135" fill="#1a3525" opacity=".55" />
          <circle cx="290" cy="160" r="100" fill="#c05a20" opacity=".14" />
          <circle cx="290" cy="160" r="70" fill="#e07030" opacity=".1" />
          <circle cx="290" cy="160" r="42" fill="#b8922a" opacity=".2" />
          <g fill="none" stroke="#c05a20" stroke-width=".5" opacity=".18">
            <circle cx="290" cy="160" r="112" /><circle cx="290" cy="160" r="124" />
          </g>
          <path d="M0,250 Q145,232 290,250 Q435,268 580,242 L580,320 L0,320 Z" fill="#0f0c04" opacity=".9" />
          <text x="14" y="308" fill="rgba(192,90,32,.25)" font-family="DM Mono,monospace" font-size="8" letter-spacing="1">geotérmico · precipitação mineral</text>
        </svg>
      )}
      {visual === 'satellite-grid' && (
        <svg viewBox="0 0 580 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="pvGridOcean" cx="50%" cy="50%" r="70%">
              <stop offset="0%" stop-color="#0a1e30" /><stop offset="100%" stop-color="#050d18" />
            </radialGradient>
          </defs>
          <rect width="580" height="320" fill="url(#pvGridOcean)" />
          <path d="M110,180 Q150,150 200,140 Q250,130 310,142 Q370,154 420,180 Q470,206 470,230 Q470,256 420,256 Q360,250 300,250 Q240,250 190,242 Q140,234 110,210 Z" fill="#1e3228" opacity=".95" />
          <path d="M128,182 Q166,154 214,144 Q262,134 318,148 Q374,162 418,186 Q452,206 446,228 Q436,248 392,244 Q340,238 290,240 Q236,242 192,234 Q150,226 128,206 Z" fill="#264535" opacity=".7" />
          <circle cx="190" cy="200" r="5" fill="#89c4d4" opacity=".8" />
          <circle cx="300" cy="232" r="5" fill="#89c4d4" opacity=".8" />
          <circle cx="400" cy="210" r="5" fill="#89c4d4" opacity=".8" />
          <circle cx="430" cy="172" r="4" fill="#c05a20" opacity=".75" />
          <g opacity=".06" stroke="#89c4d4" stroke-width=".4">
            <line x1="145" y1="0" x2="145" y2="320" /><line x1="290" y1="0" x2="290" y2="320" /><line x1="435" y1="0" x2="435" y2="320" />
            <line x1="0" y1="80" x2="580" y2="80" /><line x1="0" y1="160" x2="580" y2="160" /><line x1="0" y1="240" x2="580" y2="240" />
          </g>
          <text x="14" y="308" fill="rgba(137,196,212,.2)" font-family="DM Mono,monospace" font-size="8" letter-spacing="1">monitorização costeira · iNaturalist</text>
        </svg>
      )}
      {visual === 'basalt-strata' && (
        <svg viewBox="0 0 580 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <rect width="580" height="320" fill="#0c1a22" />
          <path d="M0,70 Q145,58 290,74 Q435,90 580,66" fill="none" stroke="#4a9ab0" stroke-width=".7" opacity=".4" />
          <path d="M0,120 Q145,104 290,122 Q435,140 580,112" fill="#1e2e2e" stroke="#2a5a6a" stroke-width=".8" opacity=".6" />
          <path d="M0,175 Q145,158 290,178 Q435,198 580,168" fill="#162020" stroke="#3a7a8a" stroke-width=".8" opacity=".5" />
          <path d="M0,235 Q145,216 290,238 Q435,260 580,228" fill="#1e2e2e" stroke="#b8922a" stroke-width=".7" opacity=".3" />
          <path d="M0,290 Q145,272 290,292 Q435,312 580,284" fill="#111618" stroke="#4a9ab0" stroke-width=".6" opacity=".3" />
          <path d="M300,320 Q312,210 318,120 Q322,60 318,0" fill="none" stroke="#c05a20" stroke-width="1.5" opacity=".3" stroke-dasharray="8 5" />
          <text x="14" y="308" fill="rgba(137,196,212,.2)" font-family="DM Mono,monospace" font-size="8" letter-spacing="1">estratos · linha de falha</text>
        </svg>
      )}
    </div>
  )
}

<style>
  /* Fills the consuming container (detail and teaser set their own height). */
  .pvis,
  .pvis-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pvis :global(svg) { display: block; width: 100%; height: 100%; }
</style>
